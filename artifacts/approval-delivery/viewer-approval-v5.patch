@@ -0,0 +1,38 @@
+:root { color-scheme: dark; font-family: "Segoe UI", system-ui, sans-serif; background: #0a101a; color: #eef3fc; }
+* { box-sizing: border-box; }
+body { margin: 0; min-height: 100vh; padding: 48px 20px; }
+main { margin: 0 auto; }
+.card { background: #121c2c; border: 1px solid #29374e; border-radius: 18px; padding: 30px; box-shadow: 0 18px 60px #0003; }
+.access-card { max-width: 500px; }
+.admin-page { max-width: 1050px; }
+h1 { margin: 0 0 12px; font-size: clamp(24px, 5vw, 32px); line-height: 1.2; }
+h2 { font-size: 20px; }
+p { line-height: 1.6; }
+.eyebrow, .label { font-size: 12px; font-weight: 700; letter-spacing: .1em; color: #8bb9fc; }
+.eyebrow { margin-top: 0; }
+label { display: block; margin: 18px 0 8px; font-weight: 600; }
+input { width: 100%; padding: 12px; border: 1px solid #465875; border-radius: 8px; background: #0a1423; color: inherit; font: inherit; }
+button, .button-link { font: inherit; font-weight: 600; padding: 11px 16px; border: 1px solid transparent; border-radius: 9px; color: #07152a; background: #90bdff; cursor: pointer; text-decoration: none; display: inline-block; }
+button:hover, .button-link:hover { filter: brightness(1.08); }
+button:disabled { opacity: .55; cursor: wait; }
+button:focus-visible, input:focus-visible, a:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
+form > button { margin-top: 20px; }
+.secondary { background: #1c2b42; border-color: #415371; color: #e4eeff; }
+.danger { color: #ffb4b4; background: #3a1d2a; border-color: #683446; }
+.request-code { font-family: ui-monospace, Consolas, monospace; font-size: 32px; font-weight: 700; letter-spacing: .1em; margin: 10px 0; overflow-wrap: anywhere; }
+.muted, .footnote { color: #b1bdd0; }
+.footnote { font-size: 13px; border-top: 1px solid #29374e; padding-top: 20px; margin-top: 24px; }
+.notice { color: #c3d9fb; min-height: 25px; }
+.notice.error { color: #ffb4b4; }
+.toolbar, .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
+.toolbar { margin: 22px 0; }
+.request-list { display: grid; gap: 14px; }
+.request-row { padding: 22px; border-radius: 12px; border: 1px solid #34445e; background: #0e1828; }
+.request-row h2 { margin: 0 0 10px; overflow-wrap: anywhere; }
+.request-row .request-code { font-size: 24px; }
+.request-row p { margin: 5px 0; }
+.request-row .actions { margin-top: 16px; }
+.pill { display: inline-block; padding: 3px 9px; margin-left: 10px; font-size: 12px; border-radius: 99px; color: #bfdbfe; background: #213e64; vertical-align: middle; }
+[hidden] { display: none !important; }
+a { color: #9dc7ff; }
+@media (max-width: 550px) { body { padding: 20px 12px; } .card { padding: 22px; } .actions button { flex: 1; } }
diff --git a/server/access.html b/server/access.html
new file mode 100644
index 0000000..2827c30
--- /dev/null
+++ b/server/access.html
@@ -0,0 +1,33 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="referrer" content="no-referrer">
+  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'">
+  <title>Live Workspace — Access required</title>
+  <link rel="stylesheet" href="/access.css">
+  <script src="/access.js" defer></script>
+</head>
+<body>
+  <main class="card access-card">
+    <p class="eyebrow">LIVE WORKSPACE</p>
+    <h1 id="heading">Ask the owner for access</h1>
+    <p id="description">Enter your name, then share your request code with the owner. Only the owner can approve access.</p>
+    <form id="requestForm">
+      <label for="name">Your name</label>
+      <input id="name" name="name" autocomplete="name" maxlength="80" required placeholder="How the owner knows you">
+      <button id="requestBtn" type="submit">Request access</button>
+    </form>
+    <section id="requestDetails" hidden aria-live="polite">
+      <p class="label">YOUR REQUEST CODE</p>
+      <p class="request-code" id="requestCode"></p>
+      <p id="requestStatus"></p>
+      <p class="muted" id="requestExpiry"></p>
+      <button id="endBtn" type="button" class="secondary">Cancel request</button>
+    </section>
+    <p id="notice" class="notice" role="status" aria-live="polite">Checking access…</p>
+    <p class="footnote">No payment or authenticator app needed. Keep this window open while waiting. Access requests reset if the server restarts.</p>
+  </main>
+</body>
+</html>
diff --git a/server/access.js b/server/access.js
new file mode 100644
index 0000000..7481415
--- /dev/null
+++ b/server/access.js
@@ -0,0 +1,109 @@
+(() => {
+  "use strict";
+  const byId = (id) => document.getElementById(id);
+  let timer;
+  let busy = false;
+  let failures = 0;
+  let active = true;
+  const viewerPath = new URLSearchParams(location.search).get("overlay") === "1"
+    ? "/?role=view&overlay=1" : "/?role=view";
+
+  function notice(message, error = false) {
+    byId("notice").textContent = message;
+    byId("notice").classList.toggle("error", error);
+  }
+  function continueToViewer() {
+    active = false;
+    clearTimeout(timer);
+    location.replace(viewerPath);
+  }
+  function showStatus(data) {
+    failures = 0;
+    const state = data.status || "none";
+    if (data.enabled === false || state === "approved") {
+      byId("heading").textContent = "Access approved";
+      notice("Opening your live workspace…");
+      continueToViewer();
+      return;
+    }
+    const pending = state === "pending";
+    byId("requestForm").hidden = pending;
+    byId("requestDetails").hidden = !pending;
+    byId("heading").textContent = pending ? "Waiting for approval" : "Ask the owner for access";
+    byId("description").textContent = pending
+      ? "Share this code with the owner so they can identify your request. This window opens automatically when they approve."
+      : "Enter your name, then share your request code with the owner. Only the owner can approve access.";
+    byId("requestCode").textContent = pending ? data.code || "" : "";
+    byId("requestStatus").textContent = pending ? `Request from ${data.name || "you"}` : "";
+    byId("requestExpiry").textContent = pending && data.pendingExpiresAt
+      ? `Request expires ${new Date(data.pendingExpiresAt).toLocaleString()}.` : "";
+    const messages = {
+      none: "", pending: "Waiting for the owner…",
+      rejected: "The owner declined this request. You can request access again.",
+      revoked: "The owner ended your access. Request approval to use the workspace again.",
+      expired: "Your access or request expired. Request approval again to continue."
+    };
+    notice(messages[state] || "Request access to continue.");
+  }
+  function schedule() {
+    clearTimeout(timer);
+    if (active) timer = setTimeout(checkStatus, Math.min(3000 * (2 ** failures), 30000));
+  }
+  async function checkStatus() {
+    if (!active || busy) return;
+    busy = true;
+    try {
+      const response = await fetch("/api/access/status", { cache: "no-store", credentials: "same-origin" });
+      if (!response.ok) throw new Error("Unavailable");
+      showStatus(await response.json());
+    } catch {
+      failures = Math.min(failures + 1, 4);
+      notice("Connection interrupted. Checking again automatically…", true);
+    } finally {
+      busy = false;
+      schedule();
+    }
+  }
+  byId("requestForm").addEventListener("submit", async (event) => {
+    event.preventDefault();
+    const name = byId("name").value.trim();
+    if (!name || busy) return;
+    busy = true;
+    byId("requestBtn").disabled = true;
+    clearTimeout(timer);
+    notice("Sending your request…");
+    try {
+      const response = await fetch("/api/access/request", {
+        method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ name })
+      });
+      const data = await response.json();
+      if (!response.ok) throw new Error(data.error || "Could not request access. Try again.");
+      showStatus(data);
+    } catch (error) {
+      notice(error.message || "Could not request access. Try again.", true);
+    } finally {
+      busy = false;
+      byId("requestBtn").disabled = false;
+      schedule();
+    }
+  });
+  byId("endBtn").addEventListener("click", async () => {
+    if (busy) return;
+    busy = true;
+    byId("endBtn").disabled = true;
+    try {
+      const response = await fetch("/api/access/end", {
+        method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json" }, body: "{}"
+      });
+      if (!response.ok) throw new Error("Could not cancel. Try again.");
+      showStatus({ enabled: true, status: "none" });
+    } catch (error) { notice(error.message, true); }
+    finally { busy = false; byId("endBtn").disabled = false; schedule(); }
+  });
+  document.addEventListener("visibilitychange", () => {
+    if (!document.hidden && !busy) checkStatus();
+  });
+  window.addEventListener("pagehide", () => { active = false; clearTimeout(timer); });
+  checkStatus();
+})();
diff --git a/server/approval.js b/server/approval.js
new file mode 100644
index 0000000..8bd3a55
--- /dev/null
+++ b/server/approval.js
@@ -0,0 +1,145 @@
+const crypto = require("node:crypto");
+
+const PENDING_TTL_MS = 20 * 60 * 1000;
+const TERMINAL_TTL_MS = 30 * 60 * 1000;
+const DURATIONS = Object.freeze({ hour: 60 * 60 * 1000, day: 24 * 60 * 60 * 1000 });
+
+function digest(token) {
+  return crypto.createHash("sha256").update(token).digest("hex");
+}
+
+class ApprovalStore {
+  constructor({ now = Date.now, maxRequests = 2000, maxRateEntries = 2000, onChange = () => {} } = {}) {
+    this.now = now;
+    this.maxRequests = maxRequests;
+    this.maxRateEntries = maxRateEntries;
+    this.onChange = onChange;
+    this.requests = new Map();
+    this.tokens = new Map();
+    this.attempts = new Map();
+  }
+
+  publicRecord(row) {
+    if (!row) return { status: "none" };
+    return {
+      id: row.id, code: row.code, name: row.name, status: row.status,
+      createdAt: row.createdAt, pendingExpiresAt: row.pendingExpiresAt,
+      ...(row.expiresAt ? { expiresAt: row.expiresAt } : {})
+    };
+  }
+
+  expire(row) {
+    const now = this.now();
+    if ((row.status === "pending" && now >= row.pendingExpiresAt) ||
+        (row.status === "approved" && now >= row.expiresAt)) {
+      row.status = "expired";
+      row.terminalAt = now;
+      this.onChange(row.id);
+    }
+    return row;
+  }
+
+  sweep() {
+    for (const [id, row] of this.requests) {
+      this.expire(row);
+      if (row.terminalAt !== undefined && this.now() >= row.terminalAt + TERMINAL_TTL_MS) {
+        this.requests.delete(id);
+        this.tokens.delete(row.tokenHash);
+      }
+    }
+    for (const [key, row] of this.attempts) {
+      if (this.now() >= row.resetAt) this.attempts.delete(key);
+    }
+  }
+
+  allowAttempt(identity) {
+    this.sweep();
+    let row = this.attempts.get(identity);
+    if (!row) {
+      if (this.attempts.size >= this.maxRateEntries) return false;
+      row = { count: 0, resetAt: this.now() + 15 * 60 * 1000 };
+      this.attempts.set(identity, row);
+    }
+    row.count += 1;
+    return row.count <= 10;
+  }
+
+  byToken(token) {
+    if (typeof token !== "string" || !/^[a-f0-9]{64}$/.test(token)) return null;
+    const id = this.tokens.get(digest(token));
+    const row = this.requests.get(id);
+    return row ? this.expire(row) : null;
+  }
+
+  isApproved(id) {
+    const row = this.requests.get(id);
+    return Boolean(row && this.expire(row).status === "approved");
+  }
+
+  create(name, token) {
+    this.sweep();
+    const existing = this.byToken(token);
+    if (existing && (existing.status === "pending" || existing.status === "approved")) {
+      return { row: existing, token: null };
+    }
+    if (this.requests.size >= this.maxRequests) {
+      const error = new Error("Too many access requests. Try again later.");
+      error.status = 503;
+      throw error;
+    }
+    const privateToken = crypto.randomBytes(32).toString("hex");
+    const id = crypto.randomBytes(16).toString("hex");
+    let code;
+    const codes = new Set([...this.requests.values()].map((row) => row.code));
+    do {
+      code = crypto.randomBytes(4).toString("hex").toUpperCase();
+      code = `${code.slice(0, 4)}-${code.slice(4)}`;
+    } while (codes.has(code));
+    const now = this.now();
+    const row = {
+      id, code, name, status: "pending", createdAt: now,
+      pendingExpiresAt: now + PENDING_TTL_MS, tokenHash: digest(privateToken)
+    };
+    this.requests.set(id, row);
+    this.tokens.set(row.tokenHash, id);
+    return { row, token: privateToken };
+  }
+
+  change(id, action, duration) {
+    const row = this.requests.get(id);
+    if (!row) return { status: 404, error: "Request not found" };
+    this.expire(row);
+    if (action === "approve" && row.status === "pending" && Object.hasOwn(DURATIONS, duration)) {
+      row.status = "approved";
+      row.expiresAt = this.now() + DURATIONS[duration];
+    } else if (action === "reject" && row.status === "pending") {
+      row.status = "rejected";
+      row.terminalAt = this.now();
+    } else if (action === "revoke" && row.status === "approved") {
+      row.status = "revoked";
+      row.terminalAt = this.now();
+    } else {
+      return { status: 409, error: "This request has changed. Refresh and try again." };
+    }
+    this.onChange(id);
+    return { status: 200, row };
+  }
+
+  end(token) {
+    const row = this.byToken(token);
+    if (!row) return;
+    if (row.status === "pending" || row.status === "approved") {
+      row.status = "revoked";
+      row.terminalAt = this.now();
+      this.onChange(row.id);
+    }
+  }
+
+  list() {
+    this.sweep();
+    return [...this.requests.values()].sort((a, b) => b.createdAt - a.createdAt)
+      .map((row) => this.publicRecord(row));
+  }
+}
+
+module.exports = { ApprovalStore, PENDING_TTL_MS, TERMINAL_TTL_MS, DURATIONS };
diff --git a/server/markdown.js b/server/markdown.js
new file mode 100644
index 0000000..d806ad3
--- /dev/null
+++ b/server/markdown.js
@@ -0,0 +1,58 @@
+(function (root) {
+  function fromElement(element) {
+    const children = (node) => Array.from(node.childNodes || []).map(walk).join("");
+    const inline = (node) => children(node).trim();
+    function walk(node) {
+      if (node.nodeType === 3) return node.textContent.replace(/[\\`*_[\]]/g, "\\$&");
+      if (node.nodeType !== 1) return "";
+      const tag = node.tagName.toLowerCase();
+      if (["button", "script", "style", "svg", "nav", "aside", "form"].includes(tag)) return "";
+      if (node.classList.contains("code-wrap")) return walk(node.querySelector("pre"));
+      if (tag === "pre") {
+        const code = node.querySelector("code") || node;
+        const text = code.textContent.replace(/\r\n/g, "\n").replace(/\n$/, "");
+        const lang = node.getAttribute("data-lang") || code.getAttribute("data-language")
+          || (/language-([\w+-]+)/.exec(code.className || "") || [])[1] || "";
+        const fence = "`".repeat(Math.max(3, ...Array.from(text.matchAll(/`+/g), m => m[0].length + 1)));
+        return `\n\n${fence}${lang}\n${text}\n${fence}\n\n`;
+      }
+      if (tag === "code") {
+        const text = node.textContent;
+        const fence = "`".repeat(Math.max(1, ...Array.from(text.matchAll(/`+/g), m => m[0].length + 1)));
+        return `${fence}${text}${fence}`;
+      }
+      if (tag === "br") return "\n";
+      if (tag === "strong" || tag === "b") return `**${inline(node)}**`;
+      if (tag === "em" || tag === "i") return `*${inline(node)}*`;
+      if (tag === "del" || tag === "s") return `~~${inline(node)}~~`;
+      if (/^h[1-6]$/.test(tag)) return `\n\n${"#".repeat(Number(tag[1]))} ${inline(node)}\n\n`;
+      if (tag === "a") {
+        const href = node.getAttribute("href") || "";
+        return /^(https?:\/\/|mailto:)/i.test(href)
+          ? `[${inline(node)}](<${href.replace(/[<>\s]/g, c => encodeURIComponent(c))}>)` : inline(node);
+      }
+      if (tag === "ul" || tag === "ol") {
+        let index = Number(node.getAttribute("start")) || 1;
+        const items = Array.from(node.children).filter(n => n.tagName === "LI").map(li => {
+          const marker = tag === "ol" ? `${index++}. ` : "- ";
+          return marker + children(li).trim().replace(/\n/g, "\n" + " ".repeat(marker.length));
+        });
+        return `\n\n${items.join("\n")}\n\n`;
+      }
+      if (tag === "table") {
+        const rows = Array.from(node.querySelectorAll("tr")).map(tr =>
+          Array.from(tr.children).filter(c => /^(TH|TD)$/.test(c.tagName))
+            .map(c => inline(c).replace(/\|/g, "\\|").replace(/\n+/g, "<br>")));
+        if (!rows.length) return "";
+        const row = cells => `| ${cells.join(" | ")} |`;
+        return `\n\n${[row(rows[0]), row(rows[0].map(() => "---")), ...rows.slice(1).map(row)].join("\n")}\n\n`;
+      }
+      if (tag === "blockquote") return `\n\n${inline(node).replace(/^/gm, "> ")}\n\n`;
+      if (tag === "hr") return "\n\n---\n\n";
+      const text = children(node);
+      return ["p", "div", "section", "article"].includes(tag) ? `\n\n${text.trim()}\n\n` : text;
+    }
+    return walk(element).trim();
+  }
+  root.LiveMarkdown = { fromElement };
+})(globalThis);
