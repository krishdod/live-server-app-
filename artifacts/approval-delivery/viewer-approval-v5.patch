+:root {
+  color-scheme: dark;
+  font-family: "Segoe UI", system-ui, sans-serif;
+  color: #e9edf5;
+  background: #10151d;
+  font-synthesis: none;
+}
+
+* { box-sizing: border-box; }
+body { margin: 0; min-width: 560px; }
+button, input { font: inherit; }
+button { cursor: pointer; }
+button:disabled { cursor: default; opacity: 0.45; }
+button:focus-visible, input:focus-visible { outline: 2px solid #8eaaff; outline-offset: 3px; }
+
+/* The native viewer starts at y=176 (or 128 when compact). Keep this exact. */
+.toolbar {
+  height: 176px;
+  padding: 14px 18px;
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  background: #171e29;
+  border-bottom: 1px solid #303c4e;
+}
+body.compact .toolbar { height: 128px; }
+body.compact .address-row { display: none; }
+body.compact .welcome { min-height: calc(100vh - 128px); }
+
+.heading-row, .controls-row, .hint-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
+.heading-row { min-height: 24px; }
+h1 { margin: 0; font-size: 15px; font-weight: 650; letter-spacing: -0.2px; white-space: nowrap; }
+h1 span { color: #95a1b5; font-weight: 400; margin-left: 4px; }
+.protection { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 600; white-space: nowrap; }
+.protection::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
+.protection.pending { color: #aab6c8; }
+.protection.enabled { color: #93d6b2; }
+.protection.unavailable { color: #f2b58b; }
+
+.address-row { display: flex; height: 38px; gap: 8px; }
+.address-row input { width: 100%; min-width: 0; padding: 0 11px; border: 1px solid #3a475b; border-radius: 6px; color: #e9edf5; background: #10151d; font-size: 13px; }
+.address-row input::placeholder { color: #8390a5; }
+.primary { min-width: 76px; border: 1px solid #9bb2ff; border-radius: 6px; color: #111a32; background: #a9bcff; font-size: 13px; font-weight: 650; }
+.primary:hover:not(:disabled) { background: #bccaff; }
+.controls-row { height: 28px; }
+.control-group { display: flex; align-items: center; gap: 14px; min-width: 0; }
+.pin-control { display: flex; align-items: center; gap: 7px; color: #bac5d6; font-size: 12px; user-select: none; cursor: pointer; }
+.pin-control input { accent-color: #a9bcff; margin: 0; width: 14px; height: 14px; }
+.opacity-control { display: inline-flex; align-items: center; gap: 4px; color: #bac5d6; font-size: 12px; }
+.opacity-control button {
+  width: 26px; height: 24px; padding: 0; color: #c5cfdd; background: transparent;
+  border: 1px solid #354154; border-radius: 5px; font-size: 14px; line-height: 1;
+}
+.opacity-control button:hover:not(:disabled) { background: #293447; color: #fff; }
+#opacity-label { min-width: 38px; text-align: center; font-variant-numeric: tabular-nums; color: #d5deec; }
+.window-actions { display: flex; gap: 5px; }
+.window-actions button { color: #c5cfdd; background: transparent; border: 1px solid #354154; border-radius: 5px; padding: 4px 10px; font-size: 12px; line-height: 17px; }
+.window-actions button:hover:not(:disabled) { background: #293447; color: #fff; }
+.hint-row { min-height: 22px; align-items: center; }
+#status-message { color: #98a7bd; font-size: 11px; line-height: 15px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+#status-message.error-message { color: #ffbcaf; }
+#shortcut-hint { flex: 0 0 auto; color: #93a0b6; font-size: 10px; white-space: nowrap; }
+kbd { font: inherit; color: #bec9da; }
+
+.welcome { min-height: calc(100vh - 176px); padding: 40px 32px; display: flex; align-items: flex-start; justify-content: center; }
+.welcome-content { width: 100%; max-width: 590px; }
+.eyebrow { color: #8fa8e8; font-size: 10px; font-weight: 650; letter-spacing: 1.4px; }
+h2 { font-size: 28px; letter-spacing: -0.8px; line-height: 1.2; font-weight: 600; margin: 12px 0 14px; }
+p { color: #a6b3c6; font-size: 14px; line-height: 1.65; margin: 0 0 22px; }
+ol { list-style: none; padding: 0; margin: 27px 0 30px; }
+li { display: flex; gap: 13px; align-items: flex-start; margin: 17px 0; font-size: 13px; line-height: 1.6; color: #c0cbdb; }
+li > span { border: 1px solid #36455e; border-radius: 50%; width: 24px; height: 24px; flex: 0 0 24px; display: flex; align-items: center; justify-content: center; color: #9db7f5; font-size: 11px; }
+.privacy-note { border-top: 1px solid #2c3748; padding-top: 20px; }
+.privacy-note strong { color: #c7d2e2; font-size: 13px; font-weight: 600; }
+.privacy-note p { font-size: 12px; margin-top: 7px; margin-bottom: 16px; }
+.local-note { color: #8190a6; font-size: 11px; }
+.error { color: #ffbcaf; font-size: 13px; }
+.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
+
+@media (max-width: 650px) {
+  .toolbar { padding-left: 14px; padding-right: 14px; }
+  h1 { font-size: 14px; }
+  .hint-row { gap: 8px; }
+  #status-message { font-size: 10px; }
+  #shortcut-hint { font-size: 9px; }
+  .welcome { padding: 32px 24px; }
+}
diff --git a/desktop-viewer/home.html b/desktop-viewer/home.html
