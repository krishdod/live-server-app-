@@ -0,0 +1,71 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'">
+  <title>Live Workspace Viewer</title>
+  <link rel="stylesheet" href="home.css">
+  <script src="home.js" defer></script>
+</head>
+<body>
+  <header class="toolbar">
+    <div class="heading-row">
+      <h1>Live Workspace <span>Viewer</span></h1>
+      <span id="protection" class="protection pending" role="status">Checking protection…</span>
+    </div>
+
+    <form id="open-form" class="address-row" autocomplete="off">
+      <label for="viewer-url" class="sr-only">Viewer link</label>
+      <input id="viewer-url" type="url" inputmode="url" value="https://live-workspace.onrender.com/access" placeholder="Paste your viewer link" spellcheck="false" autocomplete="off" required>
+      <button id="open-button" class="primary" type="submit">Open</button>
+    </form>
+
+    <div class="controls-row">
+      <div class="control-group">
+        <label class="pin-control" title="Keep this window above other apps (Ctrl+Alt+T)">
+          <input id="pin" type="checkbox" checked> Always on Top
+        </label>
+        <label class="pin-control" title="Click apps behind this window (Ctrl+Alt+C)">
+          <input id="click-through" type="checkbox"> Click-through
+        </label>
+        <div class="opacity-control" title="Window opacity">
+          <button id="opacity-down" type="button" title="Decrease opacity (Ctrl+Alt+-)">−</button>
+          <span id="opacity-label">100%</span>
+          <button id="opacity-up" type="button" title="Increase opacity (Ctrl+Alt+=)">+</button>
+        </div>
+      </div>
+      <div class="window-actions">
+        <button id="change-link" type="button" hidden title="Show the address box again">Link</button>
+        <button id="reload" type="button" title="Reload the viewer">Reload</button>
+        <button id="hide" type="button" disabled title="Waiting for keyboard shortcut">Hide</button>
+        <button id="close" type="button" title="Close this app">Close</button>
+      </div>
+    </div>
+
+    <div class="hint-row">
+      <span id="status-message" role="status">Open the access page to request approval.</span>
+      <span id="shortcut-hint"><kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>V</kbd> · <kbd>T</kbd> pin · <kbd>C</kbd> click-through · <kbd>=</kbd>/<kbd>-</kbd> opacity</span>
+    </div>
+  </header>
+
+  <main class="welcome">
+    <div class="welcome-content">
+      <div class="eyebrow">YOUR LIVE PAGE, IN ITS OWN WINDOW</div>
+      <h2>Request access, then open your live page.</h2>
+      <p>Choose Open, request access, and share your request code with the owner. The page stays visible while you wait. Once approved, your familiar viewer controls become available.</p>
+      <ol>
+        <li><span>1</span><div>After approval, the toolbar shrinks and the viewer hides once. Press Ctrl+Alt+V to show it.</div></li>
+        <li><span>2</span><div>Keep Always on Top on. With Click-through on, clicks go to apps behind; hover the toolbar to use controls.</div></li>
+        <li><span>3</span><div>Use opacity and Ctrl+Alt+V as needed, and test capture protection with your meeting app.</div></li>
+      </ol>
+      <div class="privacy-note">
+        <strong>Protection has limits.</strong>
+        <p>This window requests exclusion from compatible screen captures. Other apps are unaffected, and this app remains visible in Task Manager. Some capture methods may still show its contents.</p>
+      </div>
+      <p class="local-note">Approval is kept only for this app session. Nothing connects until you choose Open. Closing the app requires a new request next time.</p>
+      <p id="open-error" class="error" role="alert" hidden></p>
+    </div>
+  </main>
+</body>
+</html>
diff --git a/desktop-viewer/home.js b/desktop-viewer/home.js
new file mode 100644
index 0000000..3796fc0
--- /dev/null
+++ b/desktop-viewer/home.js
@@ -0,0 +1,197 @@
+"use strict";
+
+const api = window.viewerApi;
+const form = document.getElementById("open-form");
+const urlInput = document.getElementById("viewer-url");
+const openButton = document.getElementById("open-button");
+const protectionLabel = document.getElementById("protection");
+const statusMessage = document.getElementById("status-message");
+const errorMessage = document.getElementById("open-error");
+const hideButton = document.getElementById("hide");
+const shortcutHint = document.getElementById("shortcut-hint");
+const pinCheckbox = document.getElementById("pin");
+const clickThroughCheckbox = document.getElementById("click-through");
+const changeLinkButton = document.getElementById("change-link");
+const opacityLabel = document.getElementById("opacity-label");
+const opacityUp = document.getElementById("opacity-up");
+const opacityDown = document.getElementById("opacity-down");
+const DEFAULT_VIEWER_URL = "https://live-workspace.onrender.com/access";
+const FULL_HEADER = 176;
+const COMPACT_HEADER = 128;
+let opening = false;
+let currentStatus = null;
+let lastPointerOverToolbar = true;
+
+function showError(message) {
+  const text = message || "The viewer could not open. Check the link and try again.";
+  errorMessage.textContent = text;
+  errorMessage.hidden = false;
+  statusMessage.textContent = text;
+  statusMessage.title = text;
+  statusMessage.classList.add("error-message");
+}
+
+function headerLimit() {
+  return document.body.classList.contains("compact") ? COMPACT_HEADER : FULL_HEADER;
+}
+
+function concealLink() {
+  urlInput.value = "";
+  form.hidden = true;
+  changeLinkButton.hidden = false;
+  document.body.classList.add("compact");
+}
+
+function revealLinkEditor() {
+  form.hidden = false;
+  changeLinkButton.hidden = true;
+  document.body.classList.remove("compact");
+  if (!urlInput.value) urlInput.value = DEFAULT_VIEWER_URL;
+  urlInput.focus();
+  urlInput.select();
+  if (api) api.setLinkBarVisible(true).catch(() => {});
+}
+
+function applyStatus(status) {
+  currentStatus = status || {};
+  const protectedWindow = currentStatus.supported && currentStatus.protection;
+  protectionLabel.textContent = protectedWindow ? "Capture protection on" : "Protection unavailable";
+  protectionLabel.className = `protection ${protectedWindow ? "enabled" : "unavailable"}`;
+  protectionLabel.title = protectedWindow
+    ? "Capture exclusion is enabled. Verify it in your sharing app."
+    : "This app cannot confirm capture protection on this system.";
+  hideButton.disabled = !currentStatus.shortcut;
+  hideButton.title = currentStatus.shortcut
+    ? "Hide this window; Ctrl+Alt+V (Control+Option+V on Mac) brings it back"
+    : "Hide is unavailable because the keyboard shortcut could not be registered";
+
+  const parts = [];
+  if (currentStatus.shortcut) parts.push("<kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>V</kbd> show/hide");
+  if (currentStatus.pinShortcut) parts.push("<kbd>T</kbd> pin");
+  if (currentStatus.clickThroughShortcut) parts.push("<kbd>C</kbd> click-through");
+  if (currentStatus.opacityUpShortcut || currentStatus.opacityDownShortcut) parts.push("<kbd>=</kbd>/<kbd>-</kbd> opacity");
+  shortcutHint.hidden = parts.length === 0;
+  shortcutHint.innerHTML = parts.join(" · ");
+
+  pinCheckbox.checked = Boolean(currentStatus.pinned);
+  clickThroughCheckbox.checked = Boolean(currentStatus.clickThrough);
+  clickThroughCheckbox.disabled = Boolean(currentStatus.interactivePage);
+  clickThroughCheckbox.title = currentStatus.interactivePage
+    ? "Available after approval and sign-in. This page needs mouse input."
+    : "Click apps behind the live viewer";
+
+  const percent = Math.round((Number(currentStatus.opacity) || 1) * 100);
+  opacityLabel.textContent = `${percent}%`;
+  opacityUp.disabled = Boolean(currentStatus.interactivePage) || percent >= 100;
+  opacityDown.disabled = Boolean(currentStatus.interactivePage) || percent <= 20;
+
+  if (currentStatus.linkHidden) concealLink();
+  else if (!form.hidden && !opening) {
+    changeLinkButton.hidden = true;
+    document.body.classList.remove("compact");
+  }
+
+  statusMessage.classList.remove("error-message");
+  statusMessage.textContent = !currentStatus.shortcut
+    ? "Show/hide shortcut unavailable. This app stays on the taskbar/Dock."
+    : currentStatus.message || "Open the access page to request approval.";
+  statusMessage.title = [statusMessage.textContent, currentStatus.message].filter(Boolean).join(" ");
+}
+
+form.addEventListener("submit", async (event) => {
+  event.preventDefault();
+  if (opening) return;
+  opening = true;
+  openButton.disabled = true;
+  openButton.textContent = "Opening…";
+  errorMessage.hidden = true;
+  statusMessage.classList.remove("error-message");
+  statusMessage.textContent = "Opening your viewer…";
+  try {
+    const result = await api.open(urlInput.value.trim());
+    if (!result || !result.ok) {
+      showError(result && result.error);
+    } else {
+      applyStatus(result);
+    }
+  } catch {
+    showError("The viewer could not open. Check the link and try again.");
+  } finally {
+    opening = false;
+    openButton.disabled = false;
+    openButton.textContent = "Open";
+  }
+});
+
+changeLinkButton.addEventListener("click", () => {
+  revealLinkEditor();
+});
+
+document.getElementById("reload").addEventListener("click", () => api.reload());
+hideButton.addEventListener("click", () => {
+  if (!hideButton.disabled) api.hide();
+});
+document.getElementById("close").addEventListener("click", () => api.quit());
+pinCheckbox.addEventListener("change", async () => {
+  try {
+    const status = await api.setPinned(pinCheckbox.checked);
+    if (status) applyStatus(status);
+  } catch {
+    pinCheckbox.checked = Boolean(currentStatus && currentStatus.pinned);
+    showError("The window position setting could not be changed.");
+  }
+});
+clickThroughCheckbox.addEventListener("change", async () => {
+  try {
+    const status = await api.setClickThrough(clickThroughCheckbox.checked);
+    if (status) applyStatus(status);
+  } catch {
+    clickThroughCheckbox.checked = Boolean(currentStatus && currentStatus.clickThrough);
+    showError("Click-through could not be changed.");
+  }
+});
+
+async function changeOpacity(delta) {
+  try {
+    const status = await api.adjustOpacity(delta);
+    if (status) applyStatus(status);
+  } catch {
+    showError("Opacity could not be changed.");
+  }
+}
+opacityUp.addEventListener("click", () => changeOpacity(0.05));
+opacityDown.addEventListener("click", () => changeOpacity(-0.05));
+
+function syncPointer(clientY) {
+  if (!api) return;
+  const over = clientY < headerLimit();
+  if (over === lastPointerOverToolbar) return;
+  lastPointerOverToolbar = over;
+  api.setPointerOverToolbar(over).catch(() => {});
+}
+document.addEventListener("mousemove", (event) => syncPointer(event.clientY));
+document.addEventListener("mouseleave", () => {
+  lastPointerOverToolbar = false;
+  if (api) api.setPointerOverToolbar(false).catch(() => {});
+});
+
+if (api) {
+  const unsubscribe = api.onStatus(applyStatus);
+  window.addEventListener("unload", () => {
+    if (typeof unsubscribe === "function") unsubscribe();
+  }, { once: true });
+  Promise.resolve(api.status()).then(applyStatus).catch(() => {
+    applyStatus({});
+    showError("Could not check window protection. Close and reopen this app.");
+  });
+} else {
+  applyStatus({});
+  openButton.disabled = true;
+  pinCheckbox.disabled = true;
+  clickThroughCheckbox.disabled = true;
+  opacityUp.disabled = true;
+  opacityDown.disabled = true;
+  document.getElementById("reload").disabled = true;
+  document.getElementById("close").disabled = true;
+  showError("Open the desktop app to use this viewer.");
+}
diff --git a/desktop-viewer/main.js b/desktop-viewer/main.js
new file mode 100644
index 0000000..ea1f606
--- /dev/null
+++ b/desktop-viewer/main.js
@@ -0,0 +1,424 @@
+"use strict";
+const path = require("node:path");
+const os = require("node:os");
+const { pathToFileURL } = require("node:url");
+const { normalizeViewerUrl, allowedNavigation, isReadyViewer, supportsCaptureExclusion } = require("./policy");
+
+const HEADER_HEIGHT = 176;
+const COMPACT_HEADER_HEIGHT = 128;
+const TOGGLE_SHORTCUT = "Control+Alt+V";
+const PIN_SHORTCUT = "Control+Alt+T";
+const OPACITY_UP_SHORTCUT = "Control+Alt+=";
+const OPACITY_DOWN_SHORTCUT = "Control+Alt+-";
+const CLICK_THROUGH_SHORTCUT = "Control+Alt+C";
+const OPACITY_STEP = 0.05;
+const MIN_OPACITY = 0.2;
+const MAX_OPACITY = 1;
+const CHANNELS = ["status", "open", "reload", "hide", "quit", "pin", "opacity", "clickThrough", "pointer", "linkBar"]
+  .map(name => `viewer:${name}`);
+
+function createViewer(electron, options = {}) {
+  const { app, BrowserWindow, WebContentsView, globalShortcut, ipcMain, session, screen } = electron;
+  const supported = supportsCaptureExclusion(options.platform ?? process.platform, options.release ?? os.release());
+  const homePath = path.join(__dirname, "home.html");
+  const homeUrl = pathToFileURL(homePath).href;
+  let protectedContent = false;
+  let shortcut = false;
+  let pinShortcut = false;
+  let opacityUpShortcut = false;
+  let opacityDownShortcut = false;
+  let clickThroughShortcut = false;
+  let pinned = true;
+  let opacity = 1;
+  let clickThrough = false;
+  let interactivePage = true;
+  let hasOpenedReadyViewer = false;
+  let pointerOverToolbar = true;
+  let linkHidden = false;
+  let headerHeight = HEADER_HEIGHT;
+  let pointerPoll = null;
+  let view = null;
+  let viewerUrl = "";
+  let loadGeneration = 0;
+  let closed = false;
+  let message = "Open the access page to request approval. The window stays visible while you wait.";
+
+  const win = new BrowserWindow({
+    title: "Live Workspace Viewer", width: 880, height: 680,
+    minWidth: 560, minHeight: 410, show: false, alwaysOnTop: true,
+    skipTaskbar: false, backgroundColor: "#10151d", autoHideMenuBar: true,
+    webPreferences: {
+      preload: path.join(__dirname, "preload.js"),
+      nodeIntegration: false, contextIsolation: true, sandbox: true,
+      webSecurity: true, devTools: false
+    }
+  });
+  win.setMenu(null);
+
+  function applyPinned() {
+    // screen-saver level keeps the window above normal apps, similar to PowerToys Always on Top.
+    try { win.setAlwaysOnTop(pinned, pinned ? "screen-saver" : "normal"); }
+    catch { win.setAlwaysOnTop(pinned); }
+    // Keep the overlay available across macOS Spaces / full-screen meetings when pinned.
+    if (typeof win.setVisibleOnAllWorkspaces === "function") {
+      try { win.setVisibleOnAllWorkspaces(pinned, { visibleOnFullScreen: pinned }); }
+      catch { /* unsupported on this host */ }
+    }
+  }
+  function applyOpacity() {
+    try { win.setOpacity(interactivePage ? 1 : opacity); } catch { /* harness / unsupported */ }
+  }
+  function applyClickThrough() {
+    if (closed) return;
+    const ignore = !interactivePage && clickThrough && !pointerOverToolbar;
+    try { win.setIgnoreMouseEvents(ignore, { forward: true }); }
+    catch {
+      try { win.setIgnoreMouseEvents(ignore); } catch { /* harness / unsupported */ }
+    }
+  }
+  function syncHeaderHeight() {
+    headerHeight = linkHidden ? COMPACT_HEADER_HEIGHT : HEADER_HEIGHT;
+  }
+  function stopPointerPoll() {
+    if (pointerPoll) {
+      clearInterval(pointerPoll);
+      pointerPoll = null;
+    }
+  }
+  function refreshPointerPoll() {
+    stopPointerPoll();
+    if (interactivePage || !clickThrough || closed || !screen || typeof screen.getCursorScreenPoint !== "function") return;
+    pointerPoll = setInterval(() => {
+      if (closed || !clickThrough) return;
+      try {
+        if (typeof win.isVisible === "function" && !win.isVisible()) return;
+        const point = screen.getCursorScreenPoint();
+        const bounds = typeof win.getContentBounds === "function"
+          ? win.getContentBounds()
+          : { x: 0, y: 0, width: 0, height: 0 };
+        const over = point.x >= bounds.x && point.x < bounds.x + bounds.width &&
+          point.y >= bounds.y && point.y < bounds.y + headerHeight;
+        if (over !== pointerOverToolbar) {
+          pointerOverToolbar = over;
+          applyClickThrough();
+        }
+      } catch { /* ignore transient window state errors */ }
+    }, 40);
+  }
+  applyPinned();
+  applyOpacity();
+  applyClickThrough();
+
+  function snapshot() {
+    return {
+      protection: protectedContent, supported, shortcut, pinShortcut,
+      opacityUpShortcut, opacityDownShortcut, clickThroughShortcut,
+      pinned, opacity: interactivePage ? 1 : opacity,
+      clickThrough: !interactivePage && clickThrough, interactivePage, linkHidden, headerHeight, message
+    };
+  }
+  function report(text) {
+    message = text;
+    if (!closed && !win.webContents.isDestroyed()) win.webContents.send("viewer:status-changed", snapshot());
+  }
+  function applyProtection() {
+    if (!supported) return false;
+    try {
+      win.setContentProtection(true);
+      return win.isContentProtected();
+    } catch { return false; }
+  }
+  protectedContent = applyProtection();
+  if (!protectedContent) message = "Capture protection is unavailable. The live page will not open on this system.";
+
+  function restore() {
+    if (closed) return;
+    protectedContent = applyProtection();
+    if (!protectedContent && view) {
+      win.contentView.removeChildView(view);
+      view.webContents.close();
+      view = null;
+      report("Capture protection could not be restored. Reopen the app before connecting.");
+    }
+    win.setSkipTaskbar(protectedContent && shortcut);
+    applyPinned();
+    applyOpacity();
+    applyClickThrough();
+    if (win.isMinimized()) win.restore();
+    win.show();
+    win.focus();
+  }
+  function hide() {
+    if (shortcut && !closed) win.hide();
+  }
+  function setPinned(value) {
+    pinned = value === true;
+    applyPinned();
+    return snapshot();
+  }
+  function togglePinned() {
+    const status = setPinned(!pinned);
+    report(pinned ? "Always on Top is on." : "Always on Top is off.");
+    return status;
+  }
+  function adjustOpacity(delta) {
+    if (interactivePage) {
+      report("Opacity controls are available after the live viewer opens.");
+      return snapshot();
+    }
+    const next = Math.min(MAX_OPACITY, Math.max(MIN_OPACITY, Math.round((opacity + delta) * 100) / 100));
+    opacity = next;
+    applyOpacity();
+    report(`Opacity ${Math.round(opacity * 100)}%`);
+    return snapshot();
+  }
+  function setClickThrough(value) {
+    if (interactivePage) {
+      report("Click-through pauses while approval or sign-in needs your attention.");
+      return snapshot();
+    }
+    clickThrough = value === true;
+    if (!clickThrough) pointerOverToolbar = true;
+    applyClickThrough();
+    refreshPointerPoll();
+    report(clickThrough
+      ? "Click-through on — use apps behind this window. Hover the toolbar to control it."
+      : "Click-through off — this window captures mouse input.");
+    return snapshot();
+  }
+  function toggleClickThrough() {
+    return setClickThrough(!clickThrough);
+  }
+  function setPointerOverToolbar(over) {
+    pointerOverToolbar = over === true;
+    applyClickThrough();
+  }
+  function setLinkBarVisible(visible) {
+    linkHidden = visible !== true;
+    syncHeaderHeight();
+    resizeView();
+    if (!closed && !win.webContents.isDestroyed()) win.webContents.send("viewer:status-changed", snapshot());
+    return snapshot();
+  }
+  if (options.registerShortcut !== false) {
+    try {
+      shortcut = globalShortcut.register(TOGGLE_SHORTCUT, () => {
+        if (win.isVisible() && !win.isMinimized()) hide(); else restore();
+      });
+    } catch { shortcut = false; }
+    try {
+      pinShortcut = globalShortcut.register(PIN_SHORTCUT, () => { togglePinned(); });
+    } catch { pinShortcut = false; }
+    try {
+      opacityUpShortcut = globalShortcut.register(OPACITY_UP_SHORTCUT, () => { adjustOpacity(OPACITY_STEP); });
+    } catch { opacityUpShortcut = false; }
+    try {
+      opacityDownShortcut = globalShortcut.register(OPACITY_DOWN_SHORTCUT, () => { adjustOpacity(-OPACITY_STEP); });
+    } catch { opacityDownShortcut = false; }
+    try {
+      clickThroughShortcut = globalShortcut.register(CLICK_THROUGH_SHORTCUT, () => { toggleClickThrough(); });
+    } catch { clickThroughShortcut = false; }
+  }
+  // Only leave the taskbar/Dock once a global recovery shortcut is registered.
+  win.setSkipTaskbar(protectedContent && shortcut);
+  if (!shortcut && protectedContent) {
+    message = "Ctrl+Alt+V is unavailable. The viewer will stay on the taskbar/Dock.";
+  }
+
+  // Separate in-memory sessions prevent site storage/cookies crossing servers
+  // and avoid saving key-bearing viewer links in app configuration.
+  const viewerSession = session.fromPartition(`viewer-${Date.now()}-${Math.random().toString(36).slice(2)}`);
+  const mayCopy = (wc, permission, origin) => Boolean(view && wc === view.webContents && viewerUrl &&
+    permission === "clipboard-sanitized-write" && allowedNavigation(origin, viewerUrl));
+  viewerSession.setPermissionRequestHandler((wc, permission, callback, details = {}) =>
+    callback(mayCopy(wc, permission, details.requestingUrl || wc?.getURL?.())));
+  viewerSession.setPermissionCheckHandler((wc, permission, origin) => mayCopy(wc, permission, origin));
+  viewerSession.on("will-download", event => event.preventDefault());
+
+  win.webContents.setWindowOpenHandler(() => ({ action: "deny" }));
+  win.webContents.on("will-navigate", event => event.preventDefault());
+  win.webContents.on("will-attach-webview", event => event.preventDefault());
+  win.webContents.on("page-title-updated", event => event.preventDefault());
+
+  function resizeView() {
+    if (!view || closed) return;
+    const [width, height] = win.getContentSize();
+    view.setBounds({ x: 0, y: headerHeight, width, height: Math.max(0, height - headerHeight) });
+  }
+  win.on("resize", resizeView);
+
+  function showInteractivePage(text) {
+    interactivePage = true;
+    pointerOverToolbar = true;
+    applyOpacity();
+    applyClickThrough();
+    refreshPointerPoll();
+    // A revoked/expired session must not leave a hidden or unclickable gate.
+    if (options.showWindow !== false && !closed) {
+      if (win.isMinimized()) win.restore();
+      win.show();
+    }
+    report(text || "Complete approval or sign-in below. This page stays visible and clickable.");
+  }
+
+  function activateReadyViewer() {
+    if (!interactivePage) return;
+    interactivePage = false;
+    linkHidden = true;
+    syncHeaderHeight();
+    resizeView();
+    applyPinned();
+    if (!hasOpenedReadyViewer) clickThrough = true;
+    applyOpacity();
+    pointerOverToolbar = true;
+    applyClickThrough();
+    refreshPointerPoll();
+    const firstReady = !hasOpenedReadyViewer;
+    hasOpenedReadyViewer = true;
+    if (firstReady && shortcut) {
+      hide();
+      report("Viewer ready and hidden. Ctrl+Alt+V shows it · Ctrl+Alt+C toggles click-through.");
+    } else {
+      report("Viewer ready. Your window controls are available; hover the toolbar to use them.");
+    }
+  }
+
+  async function openViewer(raw) {
+    if (closed) return { ok: false, error: "The viewer is closed." };
+    let next;
+    try { next = normalizeViewerUrl(raw); }
+    catch (error) { return { ok: false, error: error.message }; }
