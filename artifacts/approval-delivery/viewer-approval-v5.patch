+const fs = require('node:fs');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { JSDOM } = require('jsdom');
+const root = path.join(__dirname, '..');
+
+function harness(t) {
+  const dom = new JSDOM('<!doctype html><div id="answer"></div>', { runScripts: 'outside-only' });
+  t.after(() => dom.window.close());
+  for (const file of ['vendor/marked.umd.js', 'vendor/purify.min.js', 'markdown.js']) {
+    dom.window.eval(fs.readFileSync(path.join(root, file), 'utf8'));
+  }
+  const source = fs.readFileSync(path.join(root, 'viewer.html'), 'utf8');
+  dom.window.eval(source.slice(source.indexOf('function escapeHtml('), source.indexOf('function htmlToPlainText(')));
+  const answer = dom.window.document.getElementById('answer');
+  return { window: dom.window, answer, render(text) { answer.innerHTML = dom.window.plainTextToHtml(text); return answer; } };
+}
+
+test('headings, emphasis, lists and tables render as formatted elements', t => {
+  const h = harness(t);
+  h.render('# Title\n\nA **bold** and *italic* answer.\n\n1. First\n2. Second\n\n| A | B |\n| --- | --- |\n| One | Two |');
+  assert.equal(h.answer.querySelector('h1').textContent, 'Title');
+  assert.equal(h.answer.querySelector('strong').textContent, 'bold');
+  assert.equal(h.answer.querySelector('em').textContent, 'italic');
+  assert.equal(h.answer.querySelectorAll('ol > li').length, 2);
+  assert.equal(h.answer.querySelectorAll('table td').length, 2);
+});
+
+test('unfinished streamed code stays a code block and preserves indentation', t => {
+  const h = harness(t);
+  h.render('```python\ndef hello():\n    print("hello")');
+  assert.equal(h.answer.querySelector('.code-block code').textContent, 'def hello():\n    print("hello")\n');
+  assert.equal(h.answer.querySelector('.code-copy').textContent, 'Copy');
+});
+
+test('Markdown never executes embedded HTML or unsafe links', t => {
+  const h = harness(t);
+  h.render('<script>alert(1)</script>\n<img src=x onerror=alert(1)>\n\n[bad](javascript:alert%281%29)\n\n<div onclick="alert(1)">safe</div>');
+  assert.equal(h.answer.querySelector('script,img,[onclick],[onerror],a[href^="javascript:"]'), null);
+});
+
+test('DOM capture and viewer serialization preserve Markdown and code whitespace', t => {
+  const h = harness(t);
+  h.answer.innerHTML = '<h2>Heading</h2><p>A <strong>bold</strong> word.</p><ol><li>One</li><li>Two</li></ol><table><tr><th>Name</th></tr><tr><td>Value</td></tr></table><pre><code class="language-python">a = 1\n\n\n    b = 2</code></pre>';
+  const text = h.window.LiveMarkdown.fromElement(h.answer);
+  assert.match(text, /## Heading/);
+  assert.match(text, /\*\*bold\*\*/);
+  assert.match(text, /1\. One\n2\. Two/);
+  assert.match(text, /\| Name \|\n\| --- \|\n\| Value \|/);
+  h.render(text);
+  assert.equal(h.answer.querySelector('.code-block code').textContent, 'a = 1\n\n\n    b = 2\n');
+});
+
+test('closing a streamed emphasis delimiter reformats the earlier text', t => {
+  const h = harness(t);
+  h.render('**Working');
+  h.render('**Working**');
+  assert.equal(h.answer.querySelector('strong').textContent, 'Working');
+});
diff --git a/server/test/relay.test.js b/server/test/relay.test.js
new file mode 100644
index 0000000..df1d640
--- /dev/null
+++ b/server/test/relay.test.js
@@ -0,0 +1,175 @@
+const assert = require("node:assert/strict");
+const { spawn } = require("node:child_process");
+const { once } = require("node:events");
+const path = require("node:path");
+const { test } = require("node:test");
+const WebSocket = require("ws");
+
+async function startRelay(t) {
+  const child = spawn(process.execPath, [path.join(__dirname, "..", "server.js")], {
+    env: {
+      ...process.env,
+      PORT: "0",
+      STREAM_KEY: "test-stream-key",
+      EDIT_KEY: "test-edit-key",
+      VIEW_KEY: "test-view-key",
+      VIEWER_APPROVAL_REQUIRED: "false",
+      APP_PASSWORD: "",
+      APP_ORIGIN: "",
+      NODE_ENV: "test",
+      RENDER: "",
+      SMTP_HOST: "",
+      SMTP_USER: "",
+      SMTP_PASS: ""
+    },
+    windowsHide: true,
+    stdio: ["ignore", "pipe", "pipe"]
+  });
+  t.after(async () => {
+    if (child.exitCode !== null) return;
+    const exited = once(child, "exit");
+    child.kill();
+    await exited;
+  });
+  const port = await new Promise((resolve, reject) => {
+    const timeout = setTimeout(() => reject(new Error("Relay startup timed out")), 5000);
+    let output = "";
+    child.stdout.on("data", (chunk) => {
+      output += chunk;
+      const match = output.match(/Server running on port (\d+)/);
+      if (match) {
+        clearTimeout(timeout);
+        resolve(Number(match[1]));
+      }
+    });
+    child.once("error", (error) => {
+      clearTimeout(timeout);
+      reject(error);
+    });
+    child.once("exit", (code) => {
+      clearTimeout(timeout);
+      reject(new Error(`Relay exited during startup (${code})`));
+    });
+  });
+  const base = `http://127.0.0.1:${port}`;
+  const connect = async (role = "view") => {
+    const socket = new WebSocket(`ws://127.0.0.1:${port}/?role=${role}&key=test-${role}-key`);
+    const messages = [];
+    const listeners = new Set();
+    socket.on("message", (raw) => {
+      const message = JSON.parse(raw);
+      messages.push(message);
+      for (const listener of listeners) listener();
+    });
+    socket.on("error", () => {});
+    t.after(() => socket.terminate());
+    const next = (predicate) => new Promise((resolve, reject) => {
+      const inspect = () => {
+        const index = messages.findIndex(predicate);
+        if (index < 0) return;
+        clearTimeout(timeout);
+        listeners.delete(inspect);
+        resolve(messages.splice(index, 1)[0]);
+      };
+      const timeout = setTimeout(() => {
+        listeners.delete(inspect);
+        reject(new Error("Expected relay message was not received"));
+      }, 3000);
+      listeners.add(inspect);
+      inspect();
+    });
+    await next((msg) => msg.type === "auth");
+    return { socket, messages, next };
+  };
+  const postAnswer = (text, key = "test-stream-key") => fetch(`${base}/answer`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ text, key })
+  });
+  return { base, connect, postAnswer };
+}
+
+test("ingested answers reach connected viewers and viewers joining later", async (t) => {
+  const relay = await startRelay(t);
+  const viewer = await relay.connect();
+  assert.equal((await viewer.next((msg) => msg.type === "autoCopy")).on, true);
+  assert.equal((await relay.postAnswer("The ChatGPT answer")).status, 204);
+  assert.equal((await viewer.next((msg) => msg.from === "stream")).text, "The ChatGPT answer");
+  const later = await relay.connect();
+  assert.equal((await later.next((msg) => msg.from === "server")).text, "The ChatGPT answer");
+});
+
+test("resuming sends the latest paused answer, even after manual edits", async (t) => {
+  const relay = await startRelay(t);
+  const editor = await relay.connect("edit");
+  const viewer = await relay.connect();
+  await relay.postAnswer("Initial answer");
+  await viewer.next((msg) => msg.from === "stream");
+
+  editor.socket.send(JSON.stringify({ type: "autoCopy", on: false }));
+  await viewer.next((msg) => msg.type === "autoCopy" && msg.on === false);
+  await editor.next((msg) => msg.type === "autoCopy" && msg.on === false);
+  assert.equal((await (await fetch(`${relay.base}/health`)).json()).autoCopyEnabled, false);
+  await relay.postAnswer("Partial next answer");
+  await relay.postAnswer("Finished next answer");
+
+  await fetch(`${relay.base}/api/sync`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ role: "edit", key: "test-edit-key", text: "Manual workspace text" })
+  });
+  await viewer.next((msg) => msg.from === "edit");
+  const later = await relay.connect();
+  assert.equal((await later.next((msg) => msg.from === "server")).text, "Manual workspace text");
+  assert.equal(viewer.messages.some((msg) => msg.from === "stream"), false);
+
+  editor.socket.send(JSON.stringify({ type: "autoCopy", on: true }));
+  await viewer.next((msg) => msg.type === "autoCopy" && msg.on === true);
+  assert.equal((await (await fetch(`${relay.base}/health`)).json()).autoCopyEnabled, true);
+  assert.equal((await viewer.next((msg) => msg.from === "stream")).text, "Finished next answer");
+  assert.equal((await later.next((msg) => msg.from === "stream")).text, "Finished next answer");
+  const afterResume = await relay.connect();
+  assert.equal((await afterResume.next((msg) => msg.from === "server")).text, "Finished next answer");
+});
+
+test("empty answer snapshots clear the viewer on reconnect", async (t) => {
+  const relay = await startRelay(t);
+  await relay.postAnswer("Old response");
+  await relay.postAnswer("");
+  const viewer = await relay.connect();
+  assert.equal((await viewer.next((msg) => msg.from === "server")).text, "");
+});
+
+test("a rejected stream key does not replace the latest answer", async (t) => {
+  const relay = await startRelay(t);
+  await relay.postAnswer("Accepted answer");
+  assert.equal((await relay.postAnswer("Rejected answer", "wrong-key")).status, 403);
+  const viewer = await relay.connect();
+  assert.equal((await viewer.next((msg) => msg.from === "server")).text, "Accepted answer");
+});
+
+for (const mode of ["http", "websocket"]) {
+  test(`a manual ${mode} edit cancels an older queued stream update`, async (t) => {
+    const relay = await startRelay(t);
+    const editor = await relay.connect("edit");
+    const viewer = await relay.connect();
+    await viewer.next((msg) => msg.from === "server");
+    await relay.postAnswer("Older streamed answer");
+    if (mode === "http") {
+      assert.equal((await fetch(`${relay.base}/api/sync`, {
+        method: "POST", headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ role: "edit", key: "test-edit-key", text: "Newer manual edit" })
+      })).status, 204);
+    } else {
+      editor.socket.send(JSON.stringify({ type: "sync", from: "edit", text: "Newer manual edit" }));
+    }
+    assert.equal((await viewer.next((msg) => msg.from === "edit")).text, "Newer manual edit");
+    // Discard any stream data already delivered before the manual edit. Nothing
+    // older may subsequently overwrite that edit in connected viewers.
+    viewer.messages.length = 0;
+    await new Promise((resolve) => setTimeout(resolve, 160));
+    assert.equal(viewer.messages.some((msg) => msg.text === "Older streamed answer"), false);
+    const reconnected = await relay.connect();
+    assert.equal((await reconnected.next((msg) => msg.from === "server")).text, "Newer manual edit");
+  });
+}
diff --git a/server/test/ui-harness.js b/server/test/ui-harness.js
new file mode 100644
index 0000000..455c8f2
--- /dev/null
+++ b/server/test/ui-harness.js
@@ -0,0 +1,49 @@
+const fs = require("node:fs");
+const path = require("node:path");
+const vm = require("node:vm");
+const { JSDOM } = require("jsdom");
+const root = path.join(__dirname, "..");
+const flush = async () => { await new Promise(resolve => setImmediate(resolve)); await new Promise(resolve => setImmediate(resolve)); };
+const response = (data, status = 200) => ({ ok: status >= 200 && status < 300, status, json: async () => data });
+
+async function page(t, name, options = {}) {
+  const html = fs.readFileSync(path.join(root, `${name}.html`), "utf8");
+  const url = new URL(`${name === "viewer" ? "/" : `/${name}`}${options.search || ""}`, "https://workspace.test");
+  const dom = new JSDOM(html, { url: url.href, runScripts: "outside-only", pretendToBeVisual: true });
+  t.after(() => dom.window.close());
+  const { window } = dom;
+  for (const [key, value] of Object.entries(options.storage || {})) window.sessionStorage.setItem(key, value);
+  for (const [key, value] of Object.entries(options.local || {})) window.localStorage.setItem(key, value);
+  const calls = [], navigations = [], timers = new Map(), sockets = [], clipboard = [];
+  let timerId = 0;
+  const location = { protocol: url.protocol, host: url.host, origin: url.origin, search: url.search,
+    get href() { return url.href; }, set href(value) { navigations.push(value); }, replace(value) { navigations.push(value); } };
+  class FakeWebSocket {
+    static OPEN = 1;
+    constructor(address) { this.url = address; this.readyState = 0; this.sent = []; sockets.push(this); }
+    send(data) { this.sent.push(JSON.parse(data)); }
+    close() { this.readyState = 3; }
+  }
+  const context = vm.createContext({ window, document: window.document,
+    navigator: { clipboard: { writeText: async value => clipboard.push(value) } },
+    location, sessionStorage: window.sessionStorage, localStorage: window.localStorage,
+    URLSearchParams, URL, Node: window.Node, NodeFilter: window.NodeFilter, CSS: {}, WebSocket: FakeWebSocket,
+    fetch: async (url, init = {}) => { calls.push({ url, init }); return options.fetch ? options.fetch(url, init) : response({ ok: true, role: "edit", secured: false, approvalEnabled: false }); },
+    setTimeout(callback, delay) { const id = ++timerId; timers.set(id, { callback, delay }); return id; },
+    clearTimeout(id) { timers.delete(id); }, setInterval() { return ++timerId; }, clearInterval() {}, console
+  });
+  if (name === "viewer") {
+    for (const filename of ["vendor/marked.umd.js", "vendor/purify.min.js", "markdown.js"]) window.eval(fs.readFileSync(path.join(root, filename), "utf8"));
+    context.marked = window.marked; context.DOMPurify = window.DOMPurify; context.LiveMarkdown = window.LiveMarkdown;
+    vm.runInContext(html.match(/<script>([\s\S]*?)<\/script>/)[1], context);
+  } else vm.runInContext(fs.readFileSync(path.join(root, `${name}.js`), "utf8"), context);
+  await flush();
+  return { window, document: window.document, calls, navigations, timers, sockets, clipboard, context,
+    el: id => window.document.getElementById(id),
+    async click(id) { window.document.getElementById(id).click(); await flush(); },
+    async submit(id) { window.document.getElementById(id).dispatchEvent(new window.Event("submit", { bubbles: true, cancelable: true })); await flush(); },
+    async tick(delay) { const match = [...timers].find(([, timer]) => delay === undefined || timer.delay === delay); if (!match) throw new Error(`No timer with delay ${delay}`); timers.delete(match[0]); match[1].callback(); await flush(); },
+    receive(message, socket = sockets.at(-1)) { socket.onmessage({ data: JSON.stringify(message) }); }
+  };
+}
+module.exports = { page, flush, response };
diff --git a/server/test/viewer.test.js b/server/test/viewer.test.js
new file mode 100644
index 0000000..cf30adb
--- /dev/null
+++ b/server/test/viewer.test.js
@@ -0,0 +1,90 @@
+const assert = require("node:assert/strict");
+const { test } = require("node:test");
+const { page, flush, response } = require("./ui-harness");
+
+for (const storedAutoCopy of [undefined, "false", "true"]) {
+  test(`opening a viewer does not override relay settings (stored: ${storedAutoCopy})`, async t => {
+    const h = await page(t, "viewer", { local: storedAutoCopy === undefined ? {} : { "lw-auto-copy": storedAutoCopy } });
+    const socket = h.sockets[0];
+    assert.ok(socket, "viewer connects after access check");
+    socket.readyState = 1; socket.onopen();
+    h.receive({ type: "auth", role: "edit", clientId: "c1" });
+    h.receive({ type: "autoCopy", on: true });
+    assert.equal(socket.sent.length, 0);
+    assert.equal(h.el("autoCopyBtn").textContent, "Auto Copy: ON");
+    h.receive({ type: "autoCopy", on: false });
+    assert.equal(h.el("autoCopyBtn").textContent, "Auto Copy: OFF");
+    assert.equal(socket.sent.length, 0, "server state must not be echoed back");
+  });
+}
+
+test("unapproved viewer is never ready and redirects to the same-origin request page", async t => {
+  const h = await page(t, "viewer", { search: "?role=view&overlay=1&key=old-link", fetch: async () => response({ ok: false, approvalRequired: true }, 403) });
+  assert.equal(h.document.title, "Live Workspace — Access required");
+  assert.equal(h.sockets.length, 0);
+  assert.deepEqual(h.navigations, ["/access?overlay=1"]);
+  assert.equal(h.el("answer").textContent, "");
+});
+
+test("owner unlock retains editor key, opens dashboard in same tab, and exposes no secret viewer link", async t => {
+  const h = await page(t, "viewer", { search: "?role=edit&key=owner-test", fetch: async (url, init) => {
+    if (url === "/api/unlock") { assert.equal(JSON.parse(init.body).password, "test-password"); return response({ ok: true, token: "gate-test" }); }
+    if (url.startsWith("/api/share-links")) return response({ viewLink: "https://workspace.test/access", editLink: "https://workspace.test/?role=edit&key=owner-test" });
+    const params = new URL(url, "https://workspace.test").searchParams;
+    return params.get("gate") === "gate-test" ? response({ ok: true, role: "edit", approvalEnabled: true }) : response({ ok: false, passwordRequired: true }, 401);
+  } });
+  assert.equal(h.document.title, "Live Workspace — Access required");
+  assert.equal(h.el("passwordGate").classList.contains("hidden"), false);
+  h.el("passwordInput").value = "test-password";
+  await h.submit("passwordForm");
+  assert.equal(h.document.title, "Live Workspace — Ready");
+  assert.equal(h.window.sessionStorage.getItem("lw-key"), "owner-test");
+  assert.equal(h.window.sessionStorage.getItem("lw-gate"), "gate-test");
+  assert.equal(h.el("passwordInput").value, "");
+  assert.equal(h.el("accessAdminBtn").classList.contains("hidden"), false);
+  await h.click("shareBtn"); await h.click("copyLinkBtn");
+  assert.equal(h.clipboard.at(-1), "https://workspace.test/access");
+  await h.click("accessAdminBtn");
+  assert.deepEqual(h.navigations, ["/access-admin"]);
+});
+
+test("approved viewers are read-only and revocation clears answer content before redirect", async t => {
+  let revoked = false;
+  const h = await page(t, "viewer", { search: "?role=view", fetch: async () => revoked ? response({ ok: false, approvalRequired: true }, 403) : response({ ok: true, role: "view", approvalEnabled: true }) });
+  assert.equal(h.document.title, "Live Workspace — Ready");
+  assert.equal(h.el("answer").contentEditable, "false");
+  assert.equal(h.el("autoCopyBtn").disabled, true);
+  h.receive({ type: "sync", from: "server", text: "## Private answer\n\n**Formatted text**" });
+  assert.equal(h.el("answer").querySelector("h2").textContent, "Private answer");
+  revoked = true; h.sockets[0].onclose({ code: 1008 });
+  assert.equal(h.el("answer").textContent, "", "cleared synchronously before the auth check completes");
+  await flush();
+  assert.equal(h.document.title, "Live Workspace — Access required");
+  assert.deepEqual(h.navigations, ["/access"]);
+  assert.equal([...h.timers.values()].some(timer => timer.delay === 2000), false);
+});
+
+test("owner read-only password expiry shows password gate instead of guest approval", async t => {
+  let expired = false;
+  const h = await page(t, "viewer", { search: "?role=view&key=owner-test", storage: { "lw-gate": "old-gate" }, fetch: async () => expired ? response({ ok: false, passwordRequired: true }, 401) : response({ ok: true, role: "view" }) });
+  expired = true; h.sockets[0].onclose({ code: 1008 }); await flush();
+  assert.equal(h.navigations.length, 0);
+  assert.equal(h.el("passwordGate").classList.contains("hidden"), false);
+  assert.equal(h.document.title, "Live Workspace — Access required");
+});
+
+test("temporary network failure retries without requiring a new approval", async t => {
+  let fail = false;
+  const h = await page(t, "viewer", { search: "?role=view", fetch: async () => { if (fail) throw new Error("offline"); return response({ ok: true, role: "view" }); } });
+  h.receive({ type: "sync", from: "server", text: "Existing answer" });
+  h.sockets[0].onclose({ code: 1006 }); fail = true; await h.tick(2000);
+  assert.equal(h.navigations.length, 0); assert.match(h.el("answer").textContent, /Existing answer/);
+  fail = false; await h.tick(3000);
+  assert.equal(h.sockets.length, 2); assert.equal(h.document.title, "Live Workspace — Ready");
+});
+
+test("explicit legacy mode retains server-provided keyed share links", async t => {
+  const h = await page(t, "viewer", { fetch: async url => url.startsWith("/api/share-links") ? response({ viewLink: "https://workspace.test/?role=view&key=legacy-test", editLink: "owner" }) : response({ ok: true, role: "edit", approvalEnabled: false }) });
+  await h.click("shareBtn"); await h.click("copyLinkBtn");
+  assert.equal(h.clipboard.at(-1), "https://workspace.test/?role=view&key=legacy-test");
+});
