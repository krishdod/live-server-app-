+    if (!protectedContent) {
+      if (view) {
+        win.contentView.removeChildView(view);
+        view.webContents.close();
+        view = null;
+      }
+      loadGeneration++;
+      viewerUrl = "";
+      report("Capture protection is unavailable. The live page was not opened.");
+      return { ok: false, error: message };
+    }
+    const generation = ++loadGeneration;
+    if (view) {
+      win.contentView.removeChildView(view);
+      view.webContents.close();
+    }
