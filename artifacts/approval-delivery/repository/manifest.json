{
  "manifest_version": 3,
  "name": "Live Workspace",
  "version": "4.9",
  "description": "Stream ChatGPT / Perplexity answers live to teammates",
  "action": {
    "default_title": "Live Workspace",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:8765/*",
    "https://localhost:8765/*",
    "http://127.0.0.1:8765/*",
    "https://live-workspace.onrender.com/*",
    "wss://live-workspace.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
