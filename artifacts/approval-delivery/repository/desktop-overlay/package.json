{
  "name": "live-workspace-overlay",
  "version": "1.0.0",
  "private": true,
  "description": "Transparent always-on-top practice overlay for Live Workspace",
  "main": "main.js",
  "author": "Live Workspace",
  "scripts": {
    "start": "electron .",
    "start:dev": "electron . --devtools",
    "test:smoke": "electron smoke-test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:fast": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.liveworkspace.overlay",
    "productName": "Live Workspace Overlay",
    "copyright": "Copyright © Live Workspace",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup-preload.js",
      "setup.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "LiveWorkspaceOverlay-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Live Workspace Overlay",
      "uninstallDisplayName": "Live Workspace Overlay",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "LiveWorkspaceOverlay-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "LiveWorkspaceOverlay-${version}-portable.exe"
    }
  }
}
