{
  "name": "live-workspace-private-viewer",
  "version": "1.6.0",
  "private": true,
  "description": "Desktop viewer with capture exclusion for Live Workspace (Windows and macOS)",
  "author": "Live Workspace",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:smoke": "electron smoke-test.js",
    "test:approval-smoke": "electron approval-smoke-test.js",
    "test:transparency": "electron transparency-smoke-test.js",
    "pack": "electron-builder --win dir",
    "dist": "electron-builder --win nsis portable --x64 --publish never",
    "pack:mac": "electron-builder --mac dir",
    "dist:mac": "electron-builder --mac dmg zip --universal --publish never",
    "dist:mac:zip": "electron-builder --mac zip --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "44.11.5",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "build": {
    "appId": "com.liveworkspace.privateviewer",
    "productName": "Live Workspace Viewer",
    "directories": {
      "output": "../releases"
    },
    "files": [
      "main.js",
      "policy.js",
      "appearance.js",
      "glass.css",
      "preload.js",
      "home.html",
      "home.js",
      "home.css",
      "package.json",
      "app-icon.js",
      "open-errors.js",
      "connection.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "LiveWorkspaceViewer-${version}-setup.exe",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "LiveWorkspaceViewer-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "artifactName": "LiveWorkspaceViewer-${version}-${arch}.dmg"
    },
    "artifactName": "LiveWorkspaceViewer-${version}-${os}-${arch}.${ext}"
  }
}
